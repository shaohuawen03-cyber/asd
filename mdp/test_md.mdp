; ##### SHORT TEST VERSION - do NOT use for real science #####
; Identical to md.mdp except nsteps/output frequencies were cut down
; so the whole pipeline can be smoke-tested in minutes.
; Production length: 1000 ns (1 us) production

; =====================================================================
; md.mdp - Production dynamics, 1000 ns (1 us)  (PRODUCTION MDP)
; AChE(4EY6) - peptide complex, PAS site
;
; Paper: "The equilibrated system was subjected to 1000 ns of production
;         dynamics at constant temperature (300 K) and pressure (1 bar)
;         controlled by a Langevin thermostat and a Berendsen barostat.
;         ff14SB, PBC, 12.0 A cut-offs, PME, SHAKE on X-H bonds, 2 fs
;         timestep, one frame saved every 0.2 ns -> 5000 frames."
;
; 1000 ns @ 2 fs = 500,000,000 steps
; 0.2 ns save interval = 100000 steps  -> 5000 frames exactly
;
; ---------------------------------------------------------------------
; NOTE ON THE BARO/THERMOSTAT
; The paper uses Berendsen pressure coupling for the production run.
; Berendsen does not sample a true NPT ensemble (no correct volume
; fluctuations).  It is kept here to stay faithful to the reference
; protocol.  For a statistically rigorous production run, switch to
;     pcoupl = C-rescale        (GROMACS >= 2021, correct NPT)
; or  pcoupl = Parrinello-Rahman
; Everything else can stay unchanged.
; =====================================================================

; no 'define' -> unrestrained

; ---------------------- Run control ---------------------------------
integrator               = sd            ; Langevin dynamics (paper)
dt                       = 0.002         ; 2 fs
nsteps                   = 100           ; TEST: 100 steps = 0.2 ps (production: 500000000 = 1000 ns)
comm-mode                = Linear
nstcomm                  = 100

; ---------------------- Output --------------------------------------
; 1 frame / 0.2 ns -> 5000 frames over 1 us, as in the paper
nstxout                  = 0             ; no uncompressed coords
nstvout                  = 0
nstfout                  = 0
nstlog                   = 10
nstenergy                = 10
nstxout-compressed       = 10            ; TEST: every 10 steps (production: 100000 = 0.2 ns)
compressed-x-grps        = System        ; water needed for water-bridge analysis

; ---------------------- Neighbour searching -------------------------
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005

; ---------------------- Electrostatics / VdW ------------------------
coulombtype              = PME
rcoulomb                 = 1.2           ; 12.0 A
vdwtype                  = cutoff
vdw-modifier             = potential-shift-verlet
rvdw                     = 1.2           ; 12.0 A
rlist                    = 1.2
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-5
DispCorr                 = EnerPres

; ---------------------- Temperature coupling ------------------------
tcoupl                   = no            ; sd integrator = Langevin thermostat
tc-grps                  = System
tau-t                    = 1.0
ref-t                    = 300

; ---------------------- Pressure coupling ---------------------------
pcoupl                   = Berendsen     ; paper (see note above)
pcoupltype               = isotropic
tau-p                    = 2.0
ref-p                    = 1.0
compressibility          = 4.5e-5

; ---------------------- Velocity generation -------------------------
gen-vel                  = no
continuation             = yes

; ---------------------- Bonds ---------------------------------------
constraints              = h-bonds       ; SHAKE-equivalent -> 2 fs OK
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1
