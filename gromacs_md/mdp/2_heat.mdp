; ============================================================
; STEP 2: NVT 升温 (NVT Heating 0 -> 300 K, 1.0 ns)
; 论文 2.3: 在重原子约束下, 于 1 ns 内持续升温至 300 K
; 说明: 采用 Gromacs 标准模拟退火(Simulated Annealing)实现连续线性升温
; ============================================================
integrator               = md
dt                       = 0.002        ; 2 fs
nsteps                   = 500000       ; 1.0 ns @ 2 fs

nstxout-compressed       = 5000         ; 每 10 ps 存一帧
nstlog                   = 5000
nstcalcenergy            = 1000
nstenergy                = 1000

define                   = -DPOSRES     ; 升温阶段保留重原子约束

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

; ---- 温度控制与连续模拟退火 (Simulated Annealing 0 -> 300 K in 1.0 ns) ----
tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 300 300
annealing                = single single
annealing-npoints        = 2 2
annealing-time           = 0 1000   0 1000      ; 0 ps -> 1000 ps (1.0 ns)
annealing-temp           = 10 300   10 300      ; 从 10 K 加热至 300 K

gen_vel                  = yes
gen_temp                 = 10
gen_seed                 = -1

pbc                      = xyz
