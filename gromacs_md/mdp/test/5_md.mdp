; ============================================================
; STEP 5: 产物动力学测试模拟 (Testing Production MD, 5000 步)
; 论文对齐配置: 在 300 K, 1 bar 下进行 5000 步 (10 ps) 快速产物模拟验证
;           每 0.2 ps (0.0002 ns, 100步) 保存一个坐标帧 -> 50 帧供后续统计绘图
; ============================================================
integrator               = md
dt                       = 0.002        ; 2 fs
nsteps                   = 5000         ; 5,000 步测试

nstxout-compressed       = 100          ; 每 0.2 ps 存一帧 -> 50 帧
nstlog                   = 100
nstcalcenergy            = 100
nstenergy                = 100

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 300 300
gen_vel                  = no

pcoupl                   = berendsen
pcoupltype               = isotropic
tau_p                    = 5.0
ref_p                    = 1.0
compressibility          = 4.5e-5

pbc                      = xyz
DispCorr                 = EnerPres
