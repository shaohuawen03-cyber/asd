; ============================================================
; STEP 5: 产物动力学测试模拟 (Testing Production MD, 10000 步)
; 论文对齐配置: 在 300 K, 1 bar 下进行 10000 步 (20 ps) 快速产物模拟验证
;           每 1 ps (0.001 ns, 500步) 保存一个坐标帧 -> 20 帧供后续统计绘图
; ============================================================
integrator               = md
dt                       = 0.002        ; 2 fs
nsteps                   = 10000        ; 10,000 步测试

nstxout-compressed       = 500          ; 每 1 ps 存一帧 -> 20 帧
nstlog                   = 500
nstcalcenergy            = 500
nstenergy                = 500

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 300 300
gen_vel                  = no

pcoupl                   = berendsen
pcoupltype               = isotropic
tau_p                    = 5.0
ref_p                    = 1.0
compressibility          = 4.5e-5

pbc                      = xyz
DispCorr                 = EnerPres
