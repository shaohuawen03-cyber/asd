; ============================================================
; STEP 4: 无约束预平衡 (NPT Pre-equilibration)
; 论文 2.3: 在无任何约束条件下对体系进行 1 ns 的平衡
; ============================================================
integrator               = md
dt                       = 0.002
nsteps                   = 100         ; 测试模式: 100 步
nstxout-compressed       = 10           ; 测试模式每 10 步存一帧
nstlog                   = 10
nstcalcenergy            = 10
nstenergy                = 10
nstcomm                  = 10

; 不定义 -DPOSRES, 即无约束
define                   = -DFLEXIBLE

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
ns_type                  = grid
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 300 300
gen_vel                  = no

pcoupl                   = berendsen
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5

pbc                      = xyz
