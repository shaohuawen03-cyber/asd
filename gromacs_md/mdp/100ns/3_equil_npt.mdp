; ============================================================
; STEP 3: NPT 恒压密度平衡 (Density Equilibration, 1.0 ns)
; 论文 2.3: 在重原子位置约束下进行 1 ns NPT 恒压平衡
; ============================================================
integrator               = md
dt                       = 0.002        ; 2 fs
nsteps                   = 500000       ; 1.0 ns

nstxout-compressed       = 5000         ; 每 10 ps 存一帧
nstlog                   = 5000
nstcalcenergy            = 1000
nstenergy                = 1000

define                   = -DPOSRES     ; 保持重原子位置约束

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 300 300
gen_vel                  = no

pcoupl                   = berendsen
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5

pbc                      = xyz
DispCorr                 = EnerPres
