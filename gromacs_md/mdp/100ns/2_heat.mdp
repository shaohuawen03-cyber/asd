; ============================================================
; STEP 2: NVT 升温 (NVT Heating 0 -> 300 K, 1.0 ns)
; 论文 2.3: 在重原子约束下, 于 1 ns 内加热至 300 K
; 说明: 脚本按梯度 (100/150/200/250/300 K) 逐步升温, 每段 0.2 ns
; ============================================================
integrator               = md
dt                       = 0.002        ; 2 fs
nsteps                   = 100000       ; 0.2 ns / 梯度段 -> 5段共 1.0 ns

nstxout-compressed       = 5000         ; 每 10 ps 存一帧
nstlog                   = 5000
nstcalcenergy            = 1000
nstenergy                = 1000

define                   = -DPOSRES     ; 升温阶段保留重原子约束

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 50 50        ; 会由 run_all 脚本自动批量替换
gen_vel                  = yes
gen_temp                 = 50
gen_seed                 = -1

pbc                      = xyz
