; ============================================================
; STEP 1: 能量最小化 (Energy Minimization)
; 论文 2.3: 在重原子位置约束(3 kcal/mol/A^2 = 1255 kJ/mol/nm^2)下
;           进行 2000 步最速下降能量最小化
; ============================================================
integrator               = steep
nsteps                   = 2000
emtol                    = 1000.0
emstep                   = 0.01

define                   = -DPOSRES     ; 对重原子施加位置约束

; ---- 非键参数 ----
cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

pbc                      = xyz
