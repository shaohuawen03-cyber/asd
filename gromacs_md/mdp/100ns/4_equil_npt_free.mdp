; ============================================================
; STEP 4: NPT 无约束预平衡 (Unrestrained NPT Pre-Equilibration, 1.0 ns)
; 论文 2.3: 释放所有约束后，进行 1 ns 的 NPT 预平衡
; ============================================================
integrator               = md
dt                       = 0.002        ; 2 fs
nsteps                   = 500000       ; 1.0 ns

nstxout-compressed       = 5000
nstlog                   = 5000
nstcalcenergy            = 1000
nstenergy                = 1000

define                   = -DFLEXIBLE   ; 无约束释放体系

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 300 300
gen_vel                  = no

pcoupl                   = berendsen
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5

pbc                      = xyz
DispCorr                 = EnerPres
