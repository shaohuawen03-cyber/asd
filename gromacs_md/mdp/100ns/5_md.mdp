; ============================================================
; STEP 5: 产物动力学模拟 (Production MD, 100 ns)
; 论文 2.3: 在 300 K, 1 bar 下进行 100 ns 正式产物模拟
;           每 20 ps (0.02 ns) 保存一个坐标帧 -> 5,000 帧供后续统计分析
; ============================================================
integrator               = md
dt                       = 0.002        ; 2 fs
nsteps                   = 50000000     ; 100 ns @ 2 fs

nstxout-compressed       = 10000        ; 每 20 ps 存一帧 -> 5,000 帧
nstlog                   = 5000
nstcalcenergy            = 5000
nstenergy                = 5000

constraints              = h-bonds
constraint_algorithm     = lincs

cutoff-scheme            = Verlet
nstlist                  = 10
rlist                    = 1.2
rcoulomb                 = 1.2
rvdw                     = 1.2
coulombtype              = PME
pme_order                = 4
fourierspacing           = 0.12
vdwtype                  = cutoff
vdw-modifier             = force-switch
rvdw-switch              = 1.0

tcoupl                   = v-rescale
tc-grps                  = Protein Water_and_ions
tau_t                    = 1.0 1.0
ref_t                    = 300 300
gen_vel                  = no

pcoupl                   = berendsen
pcoupltype               = isotropic
tau_p                    = 2.0
ref_p                    = 1.0
compressibility          = 4.5e-5

pbc                      = xyz
DispCorr                 = EnerPres
